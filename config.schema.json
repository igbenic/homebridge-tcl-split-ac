{
  "pluginAlias": "TclHome",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "required": [
      "name",
      "username",
      "password"
    ],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "TCL Home",
        "required": true
      },
      "username": {
        "title": "TCL Home Email",
        "type": "string",
        "required": true,
        "description": "Email address for the TCL Home account"
      },
      "password": {
        "title": "TCL Home Password",
        "type": "string",
        "format": "password",
        "required": true,
        "description": "Password for the TCL Home account"
      },
      "debugMode": {
        "title": "Debug Mode",
        "type": "boolean",
        "default": false,
        "description": "Enable verbose Homebridge logs"
      }
    }
  }
}
